{
  "id": "tuwien.tuwel.deadlines",
  "name": "TUWEL Deadlines",
  "version": "1.0.0",
  "author": {
    "name": "TU Wien Student Devs",
    "email": "devs@student.tuwien.ac.at",
    "url": "https://github.com/tuwien-community"
  },
  "description": "Live assignment tracker & submission deadlines for TU Wien TUWEL courses",
  "entrypoint": "index.html",
  "icon": "calendar-clock",
  "type": "widget",
  "capabilities": {
    "network": [
      "https://tuwel.tuwien.ac.at/*"
    ],
    "storage": {
      "quotaBytes": 1048576
    },
    "notifications": true,
    "systemClipboard": false
  },
  "ui": {
    "minWidth": 320,
    "minHeight": 280,
    "defaultWidth": 420,
    "defaultHeight": 380,
    "resizable": true
  }
}
